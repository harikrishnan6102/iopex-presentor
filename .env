# Public ElevenLabs agent id (not a secret — it ships in the page either way).
# Override per session with ?agent=agent_xxx in the URL.
VITE_ELEVENLABS_AGENT_ID=agent_8601m25e1gmdft09d3vy3ft6bq94

# Access code for the kiosk gate. Set here on purpose: staging builds from this
# repo, with no .env.local and no CI variable, and a gate that is silently off
# is worse than a code the team can read. Treat it as a shared door code, not a
# secret — it ships in the bundle either way. Rotate it here when it leaks.
# .env.local overrides this locally; window.IOPEX_ACCESS_CODE overrides it on a
# deployed build without a rebuild.
VITE_ACCESS_CODE=iopex2026
