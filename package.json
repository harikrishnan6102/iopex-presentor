{
  "name": "iopex-presenter",
  "private": true,
  "version": "2.0.0",
  "description": "iOPEX products kiosk — React + TypeScript port of iopex-products-kiosk-v2 with the ElevenLabs voice guide and MediaPipe gesture layer.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 8081",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:gesture": "node --experimental-strip-types --no-warnings scripts/gesture-math.test.ts",
    "build:kb": "node agent/build-kb.mjs"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "gsap": "^3.12.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
